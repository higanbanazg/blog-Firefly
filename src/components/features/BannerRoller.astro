---
// 首页横幅滚筒文字：同一行位置里，先显示第一句，停留片刻后整行向上滚动换成下一句。
// 和 TypewriterText 一样是逐句展示，区别在于这里是整行滑动切换，而不是逐字打出。
interface Props {
	lines: string[]; // 依次滚动显示的句子
	hold?: number; // 每句停留时间（毫秒）
	duration?: number; // 单次滚动时长（毫秒）
	loop?: boolean; // 滚到最后一句后是否绕回第一句继续
	size?: string; // 字体大小，如 "4.5rem"
}

const { lines, hold = 2200, duration = 700, loop = false, size } = Astro.props;
---

<div
	class="banner-roller"
	data-hold={String(hold)}
	data-duration={String(duration)}
	data-loop={loop ? "1" : "0"}
	style={size ? `--banner-roller-size: ${size}` : undefined}
>
	<div class="banner-roller-track">
		{lines.map((line) => <div class="banner-roller-line">{line}</div>)}
	</div>
</div>

<script>
	interface RollerState {
		timers: number[];
		cloned: boolean;
	}

	function stopRoller(el: HTMLElement & { __rollerState?: RollerState }) {
		if (!el.__rollerState) return;
		for (const t of el.__rollerState.timers) window.clearTimeout(t);
		el.__rollerState.timers = [];
	}

	function initRoller(el: HTMLElement & { __rollerState?: RollerState }) {
		stopRoller(el);

		const track = el.querySelector<HTMLElement>(".banner-roller-track");
		if (!track) return;

		const hold = Number(el.dataset.hold) || 2200;
		const duration = Number(el.dataset.duration) || 700;
		const loop = el.dataset.loop === "1";
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// 循环模式下在末尾补一份第一句的副本，滚到副本后无动画瞬移回真正的第一句，
		// 这样看起来是一直朝同一个方向转，而不是滚到底再倒回去。
		const state: RollerState = el.__rollerState ?? { timers: [], cloned: false };
		el.__rollerState = state;
		state.timers = [];
		if (loop && !state.cloned) {
			const first = track.firstElementChild;
			if (first) track.appendChild(first.cloneNode(true));
			state.cloned = true;
		}

		const count = track.children.length;
		if (count < 2) return;

		const step = 100 / count; // translateY 的百分比是相对轨道自身高度，故一行 = 100/行数
		let index = 0;

		track.style.transition = "none";
		track.style.transform = "translateY(0)";

		const advance = (): void => {
			index += 1;
			track.style.transition = reduced
				? "none"
				: `transform ${duration}ms cubic-bezier(0.65, 0, 0.35, 1)`;
			track.style.transform = `translateY(-${index * step}%)`;

			const atClone = loop && index >= count - 1;
			if (atClone) {
				// 滚到副本上之后，等动画走完再无动画地跳回起点，接着继续
				state.timers.push(
					window.setTimeout(
						() => {
							index = 0;
							track.style.transition = "none";
							track.style.transform = "translateY(0)";
							state.timers.push(window.setTimeout(advance, hold));
						},
						reduced ? 0 : duration,
					),
				);
				return;
			}
			if (index < count - 1) state.timers.push(window.setTimeout(advance, hold + duration));
		};

		state.timers.push(window.setTimeout(advance, hold));
	}

	function initAllRollers(): void {
		for (const el of document.querySelectorAll<HTMLElement>(".banner-roller")) {
			initRoller(el);
		}
	}

	function runInit(): void {
		initAllRollers();
		// 横幅的显隐晚于内容替换，补一次（与 TypewriterText 相同的处理）
		window.setTimeout(initAllRollers, 220);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", runInit);
	} else {
		runInit();
	}

	document.addEventListener("swup:contentReplaced", runInit);
	document.addEventListener("swup:content:replace", runInit);
	document.addEventListener("swup:page:view", runInit);
	if (typeof window !== "undefined" && window.swup?.hooks) {
		window.swup.hooks.on("content:replace", runInit);
		window.swup.hooks.on("page:view", runInit);
	}
</script>
